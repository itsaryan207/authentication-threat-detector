        "import pandas as pd\n",
        "import re\n",
        "from collections import Counter\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "with open(\"logs.txt\", \"r\") as file:\n",
        "    logs = file.readlines()\n",
        "\n",
        "log_data = []\n",
        "\n",
        "pattern = r\"(\\d{4}-\\d{2}-\\d{2})\\s(\\d{2}:\\d{2}:\\d{2})\\s(\\w+)\\suser=(\\w+)\\sip=([\\d\\.]+)\"\n",
        "for log in logs:\n",
        "    match = re.match(pattern, log)\n",
        "\n",
        "    if match:\n",
        "        date, time, status, user, ip = match.groups()\n",
        "\n",
        "        log_data.append({\n",
        "            \"Date\": date,\n",
        "            \"Time\": time,\n",
        "            \"Status\": status,\n",
        "            \"User\": user,\n",
        "            \"IP\": ip\n",
        "        })\n",
        "\n",
        "df = pd.DataFrame(log_data)\n",
        "\n",
        "failed_logins = df[df[\"Status\"] == \"LOGIN_FAILED\"]\n",
        "\n",
        "ip_counts = Counter(failed_logins[\"IP\"])\n",
        "\n",
        "print(\"===== Suspicious IP Activity =====\")\n",
        "\n",
        "for ip, count in ip_counts.items():\n",
        "    print(f\"{ip} --> Failed Attempts: {count}\")\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.bar(ip_counts.keys(), ip_counts.values())\n",
        "\n",
        "plt.xlabel(\"IP Address\")\n",
        "plt.ylabel(\"Failed Attempts\")\n",
        "plt.title(\"Failed Authentication Attempts\")\n",
        "\n",
        "plt.show()"
